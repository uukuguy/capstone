{
  "schema": "capstone-capacity-policy/1",
  "description": "Declared application design bounds, not measured resource ceilings. Review flags require workload evidence before claiming adequacy. Enforcement describes intended recovery policy; consumers own enforcement.",
  "groups": [
    {
      "id": "attachment_memory",
      "members": ["attachment_buffer_bytes"],
      "category": "resource",
      "scope": "all instruction attachment reads and retained previews in one browser document",
      "protected_resource": "aggregate attachment source-byte buffers",
      "anomaly": "Concurrent reads and retained previews can accumulate across instructions.",
      "recovery": "Close another preview or wait for an active read to settle, then retry. File storage quotas are independent.",
      "enforcement": "reject_input",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "transport_payload",
      "members": [
        "control_document_bytes",
        "native_task_bytes",
        "rpc_frame_bytes",
        "rpc_batch_requests",
        "provider_request_bytes",
        "provider_response_bytes",
        "mcp_frame_bytes",
        "research_request_bytes",
        "research_response_bytes",
        "delegation_dependency_bytes",
        "delegation_reply_bytes",
        "event_bytes",
        "command_bytes",
        "json_depth",
        "json_nodes"
      ],
      "category": "protocol",
      "scope": "single message or document",
      "protected_resource": "parser and transport memory",
      "anomaly": "An oversized message or deeply nested JSON can exhaust memory or block parsing.",
      "recovery": "Split the input or use durable references; request an operator profile review if the valid input cannot fit.",
      "enforcement": "reject_input",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "stream",
      "members": [
        "provider_stream_bytes"
      ],
      "category": "protocol",
      "scope": "one Provider response stream",
      "protected_resource": "stream memory",
      "anomaly": "An accumulated unbounded response can exhaust memory if buffering is used.",
      "recovery": "Use incremental streaming; zero means no cumulative stream byte ceiling.",
      "enforcement": "stream",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "relay",
      "members": [
        "provider_relay_requests",
        "provider_relay_task_requests",
        "gateway_relay_requests",
        "gateway_relay_task_requests"
      ],
      "category": "concurrency",
      "scope": "process and task in-flight requests",
      "protected_resource": "Provider connections and relay memory",
      "anomaly": "Unbounded simultaneous requests can exhaust connection and memory capacity.",
      "recovery": "Queue independent requests until a slot is free; concurrency does not set a total-call or total-round ceiling.",
      "enforcement": "queue",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "housekeeping",
      "members": [
        "http_exchange_count",
        "http_dns_workers",
        "http_write_workers",
        "native_server_connections",
        "native_rpc_queue_frames",
        "thread_stream_count",
        "thread_streams_per_thread"
      ],
      "category": "concurrency",
      "scope": "process transport housekeeping",
      "protected_resource": "sockets, threads and pending frames",
      "anomaly": "Unbounded simultaneous transport work can exhaust file descriptors or worker memory.",
      "recovery": "Wait for transport capacity; close inactive streams and retry failed connections.",
      "enforcement": "queue",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "context",
      "members": [
        "delegation_history_count",
        "delegation_history_bytes",
        "native_context_bytes",
        "inline_material_bytes",
        "inline_material_count",
        "history_turn_count",
        "history_context_bytes",
        "history_message_bytes",
        "tool_observation_bytes",
        "context_references",
        "previous_instruction_chars",
        "previous_instruction_delta_items",
        "context_segment_bytes",
        "context_manifest_bytes",
        "context_marker_bytes",
        "prepared_context_count"
      ],
      "category": "context_window",
      "scope": "bounded task context projection",
      "protected_resource": "model context and context assembly memory",
      "anomaly": "Full history or full resources can overflow the admitted context.",
      "recovery": "Compact history, retain durable references, and read bounded segments on demand.",
      "enforcement": "compact",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "model",
      "members": [
        "model_context_tokens",
        "model_output_tokens"
      ],
      "category": "context_window",
      "scope": "one model request",
      "protected_resource": "selected model context and output allocation",
      "anomaly": "A request can exceed its configured context or output allocation.",
      "recovery": "Reduce context or split output; these application allocations are not measured model capability limits.",
      "enforcement": "user_budget",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "catalog",
      "members": [
        "tool_active_count",
        "tool_schema_chars",
        "tool_summary_chars",
        "resource_profile_items",
        "guide_resource_count",
        "guide_document_bytes",
        "guide_total_bytes",
        "guide_title_chars",
        "input_catalog_objects"
      ],
      "category": "context_window",
      "scope": "tool, guide or resource catalog projection",
      "protected_resource": "catalog assembly and model context",
      "anomaly": "An unrestricted catalog can consume the request context and process memory.",
      "recovery": "Search or load a relevant subset and retain references to omitted entries.",
      "enforcement": "compact",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "page",
      "members": [
        "tool_search_page_items",
        "artifact_page_items",
        "artifact_initial_pages",
        "product_page_items",
        "history_page_items",
        "research_page_records",
        "product_index_scan_events"
      ],
      "category": "page",
      "scope": "one page or initial page window",
      "protected_resource": "page response memory and latency",
      "anomaly": "An unrestricted list scan can produce a large response or long request.",
      "recovery": "Follow returned cursors; request another page as needed. A page size is not a total-result ceiling.",
      "enforcement": "page",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "storage",
      "members": [
        "artifact_file_bytes",
        "artifact_count",
        "delivery_file_bytes",
        "product_bytes",
        "upload_file_bytes",
        "upload_session_bytes",
        "input_staging_bytes",
        "native_storage_bytes",
        "receipt_count",
        "native_record_count",
        "native_workspace_bytes"
      ],
      "category": "storage",
      "scope": "task, session or workspace storage allocation",
      "protected_resource": "durable and local storage",
      "anomaly": "Unbounded file growth or retained records can exhaust allocated storage.",
      "recovery": "Use durable versioned references and bounded reads; request an operator budget increase for valid workloads. Storage allowance is separate from processing and context budgets.",
      "enforcement": "user_budget",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "chunk",
      "members": [
        "upload_chunk_bytes",
        "upload_chunk_max_bytes"
      ],
      "category": "protocol",
      "scope": "one upload chunk",
      "protected_resource": "upload buffer memory",
      "anomaly": "An oversized upload chunk can exhaust transfer buffers.",
      "recovery": "Upload the file in bounded chunks; chunk size does not limit total file size.",
      "enforcement": "reject_input",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "projection",
      "members": [
        "preview_bytes",
        "product_reference_count",
        "product_excerpt_bytes",
        "answer_bytes",
        "answer_summary_chars",
        "delegation_answer_chars",
        "input_text_chars",
        "research_claim_count",
        "research_note_count",
        "research_question_count",
        "research_text_chars",
        "research_summary_chars",
        "research_goal_chars",
        "research_progress_chars",
        "decision_text_chars",
        "decision_references",
        "research_finding_count",
        "research_snapshot_bytes",
        "work_count",
        "work_message_count",
        "work_state_bytes",
        "open_models",
        "diagram_categories",
        "application_state_bytes"
      ],
      "category": "projection",
      "scope": "one bounded application product or state projection",
      "protected_resource": "serialization, state and reader context memory",
      "anomaly": "An unrestricted projection can exhaust memory or make a response unusable.",
      "recovery": "Store the full resource with a durable reference; return a bounded projection and retrieve more on demand.",
      "enforcement": "spill",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "buffer",
      "members": [
        "event_buffer_count",
        "event_buffer_bytes",
        "event_page_bytes",
        "diagnostic_tail_bytes",
        "diagnostic_error_count",
        "diagnostic_path_parts",
        "diagnostic_path_chars",
        "diagnostic_text_chars"
      ],
      "category": "buffer",
      "scope": "event or diagnostic projection",
      "protected_resource": "event buffer and diagnostic memory",
      "anomaly": "Unbounded diagnostics or buffered events can exhaust memory.",
      "recovery": "Read retained events in bounded pages; retain only bounded diagnostic tails.",
      "enforcement": "page",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "task_work",
      "members": [
        "native_task_count",
        "mcp_call_count",
        "research_round_count"
      ],
      "category": "execution_budget",
      "scope": "task execution allocation",
      "protected_resource": "active task resources and execution budget",
      "anomaly": "Unbounded task fan-out or execution can consume resources without completion.",
      "recovery": "Use explicit task budgets and continuation checkpoints; review fixed total-call and round defaults against valid workloads. mcp_call_count=0 means no total-call ceiling; positive values are explicit task budgets.",
      "enforcement": "user_budget",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "deadline",
      "members": [
        "delegation_task_seconds",
        "mcp_initialize_seconds",
        "mcp_catalog_seconds",
        "mcp_tool_seconds",
        "execution_seconds",
        "research_execution_seconds",
        "intent_seconds",
        "tool_timeout_seconds",
        "artifact_transfer_seconds",
        "native_exchange_seconds",
        "native_staging_wait_seconds",
        "input_catalog_read_seconds"
      ],
      "category": "deadline",
      "scope": "single operation or task execution",
      "protected_resource": "worker slots and operation lifetime",
      "anomaly": "An operation that never completes can retain resources indefinitely.",
      "recovery": "Checkpoint progress and continue in a new bounded operation; increase the application budget for valid long tasks.",
      "enforcement": "user_budget",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "retention",
      "members": [
        "retention_seconds"
      ],
      "category": "retention",
      "scope": "retained runtime records",
      "protected_resource": "retained storage",
      "anomaly": "Records retained indefinitely can exhaust storage.",
      "recovery": "Persist required products before expiry; configure retention for the operational need.",
      "enforcement": "user_budget",
      "model_visible": true,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "transport_timing",
      "members": [
        "http_loop_start_seconds",
        "native_cancel_seconds",
        "native_http_wait_ms",
        "native_cancel_wait_ms",
        "native_server_wait_seconds"
      ],
      "category": "deadline",
      "scope": "transport startup, cancellation or polling",
      "protected_resource": "transport lifecycle",
      "anomaly": "A stalled lifecycle can retain resources or busy-loop.",
      "recovery": "Retry startup or cancel the operation; inspect backend readiness.",
      "enforcement": "deadline",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "ui",
      "members": [
        "ui_network_buses",
        "ui_network_branches",
        "ui_initial_history_messages",
        "ui_cache_items",
        "ui_model_workspace_bytes",
        "ui_input_draft_bytes",
        "ui_camera_storage_bytes",
        "ui_followup_bytes",
        "ui_session_title_chars",
        "ui_delivery_title_chars",
        "ui_delivery_scope_chars",
        "ui_delivery_support_count",
        "ui_result_summary_count",
        "ui_result_table_count",
        "ui_result_projection_count",
        "ui_result_column_count",
        "ui_result_row_count",
        "ui_result_element_count",
        "ui_result_overlay_count",
        "ui_result_text_chars",
        "ui_result_part_chars",
        "ui_result_part_count",
        "ui_case_state_bytes",
        "ui_case_details_bytes",
        "ui_case_text_chars",
        "ui_case_step_count",
        "ui_case_reason_count",
        "ui_session_page_items",
        "ui_network_event_items",
        "ui_attachment_count",
        "ui_preparation_states",
        "ui_product_resolution_bytes"
      ],
      "category": "presentation",
      "scope": "bounded browser view or browser storage",
      "protected_resource": "browser rendering and storage",
      "anomaly": "An unrestricted browser projection can exhaust browser memory or stall rendering.",
      "recovery": "Load bounded views and pages, and retain references to full server-side resources.",
      "enforcement": "page",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    },
    {
      "id": "ui_timing",
      "members": [
        "ui_case_duration_ms",
        "ui_read_attempts",
        "ui_access_attempts",
        "ui_read_retry_base_ms",
        "ui_read_retry_max_ms",
        "ui_reconnect_base_ms",
        "ui_reconnect_max_ms",
        "ui_reconnect_stable_ms",
        "ui_activity_idle_ms",
        "ui_prepare_timeout_ms",
        "ui_network_status_timeout_ms",
        "ui_network_status_refresh_ms"
      ],
      "category": "deadline",
      "scope": "browser retry, idle or display timer",
      "protected_resource": "browser connections and request rate",
      "anomaly": "Unbounded retry or stale activity can retain connections and amplify traffic.",
      "recovery": "Use bounded retries and backoff; refresh state after reconnect.",
      "enforcement": "deadline",
      "model_visible": false,
      "basis": "default_design_bound",
      "review_needed": true
    }
  ],
