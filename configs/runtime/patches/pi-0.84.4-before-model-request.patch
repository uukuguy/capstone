+
+function projectBeforeModelRequestMessage(message: Context["messages"][number]): PublicModelRequestMessage {
+	if (message.role === "user") {
+		return {
+			role: "user",
+			content: typeof message.content === "string" ? message.content : message.content.map(projectPublicContent),
+		};
+	}
+	if (message.role === "toolResult") {
+		return {
+			role: "toolResult",
+			toolCallId: message.toolCallId,
+			toolName: message.toolName,
+			content: message.content.map(projectPublicContent),
+			details: structuredClone(message.details ?? null),
+			isError: message.isError,
+		};
+	}
+	if (message.role !== "assistant") throw new Error("unsupported model request message role");
+	return {
+		role: "assistant",
