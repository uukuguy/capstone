+			if (content.type === "thinking") return { type: "thinking", redacted: true };
+			if (content.type === "toolCall") {
+				return {
+					type: "toolCall",
+					id: content.id,
+					name: content.name,
+					arguments: structuredClone(content.arguments),
+				};
+			}
+			if (content.type === "text") return { type: "text", text: content.text };
+			throw new Error("unsupported model request assistant content");
+		}),
+	};
