+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+	type Api,
+	type AssistantMessage,
+	type Context,
+	createAssistantMessageEventStream,
+	type Model,
+	type SimpleStreamOptions,
+} from "@earendil-works/pi-ai";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { createAgentSession } from "../src/core/sdk.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { type Settings, SettingsManager } from "../src/core/settings-manager.ts";
+import { createModelRegistry, getModelRuntime } from "./model-runtime-test-utils.ts";
+
+const EVENT_STORE = "__beforeModelRequestPortEvents";
+const RUNTIME_STORE = "__beforeModelRequestRuntimeCalls";
+const ORDER_STORE = "__beforeModelRequestChronology";
+
+describe("before_model_request", () => {
+	let tempDir: string;
+	let cwd: string;
+	let agentDir: string;
+
+	beforeEach(() => {
+		tempDir = mkdtempSync(join(tmpdir(), "pi-before-model-request-"));
+		cwd = join(tempDir, "project");
+		agentDir = join(tempDir, "agent");
+		mkdirSync(cwd, { recursive: true });
+		mkdirSync(agentDir, { recursive: true });
+		(globalThis as Record<string, unknown>)[EVENT_STORE] = [];
+		(globalThis as Record<string, unknown>)[RUNTIME_STORE] = 0;
+		(globalThis as Record<string, unknown>)[ORDER_STORE] = [];
+	});
+
+	afterEach(() => {
+		delete (globalThis as Record<string, unknown>)[EVENT_STORE];
+		rmSync(tempDir, { recursive: true, force: true });
+	});
+
+	it("emits the resolved semantic request before the model runtime streams", async () => {
+		const result = await runRequest({
+			settings: {
+				httpIdleTimeoutMs: 0,
+				websocketConnectTimeoutMs: 800,
+				retry: { provider: { timeoutMs: 550, maxRetries: 2, maxRetryDelayMs: 700 } },
+			},
+			requestOptions: { maxRetries: 1 },
+			extensions: [
+				`export default function(pi) {
+					pi.on("before_model_request", (event) => {
+						globalThis.${ORDER_STORE}.push("hook");
+						globalThis.${EVENT_STORE}.push({ kind: "hook", event });
+					});
+				}`,
+			],
+		});
+
+		expect(result.order).toEqual(["hook", "runtime"]);
+		const event = result.events[0] as { event: { options: Record<string, unknown> } };
+		expect(event.event.options).toEqual({
+			timeoutMs: 550,
+			websocketConnectTimeoutMs: 800,
+			maxRetries: 1,
+			maxRetryDelayMs: 700,
+		});
+		expect(result.runtimeOptions).toMatchObject(event.event.options);
+		expect(JSON.stringify(event.event)).not.toContain("test-api-key");
+	});
+
+	it("projects semantic content faithfully while redacting private and transport-only values", async () => {
+		const result = await runRequest({
+			requestOptions: {
+				timeoutMs: 321,
+				...( {
+					headers: { authorization: "Bearer request-secret" },
+					env: { PROVIDER_TOKEN: "environment-secret" },
+				} as object),
+			} as SimpleStreamOptions,
+			extensions: [
+				`export default function(pi) {
+					pi.on("before_model_request", (event) => {
+						globalThis.${EVENT_STORE}.push({ kind: "hook", event });
+					});
+				}`,
+			],
+		});
+
+		const event = (result.events[0] as { event: { context: Context; options: Record<string, unknown> } }).event;
+		expect(event.context.messages).toMatchObject([
+			{ role: "user", content: [{ type: "text", text: "inspect assets" }, { type: "image", data: "image-bytes", mimeType: "image/png" }] },
+			{
+				role: "assistant",
+				content: [
+					{ type: "thinking", redacted: true },
+					{ type: "text", text: "I will inspect the asset." },
+					{ type: "toolCall", id: "call-1", name: "inventory_lookup", arguments: { asset: "A-1" } },
+				],
+			},
+			{
+				role: "toolResult",
+				toolCallId: "call-1",
+				toolName: "inventory_lookup",
+				content: [{ type: "text", text: "asset A-1 found" }, { type: "image", data: "result-image", mimeType: "image/png" }],
+				details: { source: "inventory", revision: 7 },
+				isError: false,
+			},
+		]);
+		const serialized = JSON.stringify(event);
+		expect(serialized).not.toContain("private chain of thought");
+		expect(serialized).not.toContain("request-secret");
+		expect(serialized).not.toContain("environment-secret");
+		expect(serialized).not.toContain("test-api-key");
+	});
+
+	it("stops before ModelRuntime when a capture handler throws", async () => {
+		await expect(
+			runRequest({
+				extensions: [
+					`export default function(pi) {
+						pi.on("before_model_request", () => { throw new Error("capture rejected"); });
+					}`,
+				],
+			}),
+		).rejects.toThrow("capture rejected");
+		expect((globalThis as Record<string, unknown>)[RUNTIME_STORE]).toBe(0);
+	});
+
+	it("gives each handler an isolated public projection", async () => {
+		const result = await runRequest({
+			extensions: [
+				`export default function(pi) {
+					pi.on("before_model_request", (event) => {
+						event.context.messages[0].content[0].text = "mutated";
+						event.context.tools[0].parameters.properties.asset.type = "number";
+						event.options.timeoutMs = 0;
+					});
+				}`,
+				`export default function(pi) {
+					pi.on("before_model_request", (event) => {
+						globalThis.${EVENT_STORE}.push({ kind: "second", event });
+					});
+				}`,
+			],
+		});
+
+		const second = result.events[0] as { event: { context: Context; options: Record<string, unknown> } };
+		expect(second.event.context.messages[0]).toMatchObject({
+			role: "user",
+			content: [
+				{ type: "text", text: "inspect assets" },
+				{ type: "image", data: "image-bytes", mimeType: "image/png" },
+			],
+		});
+		expect(second.event.context.tools?.[0].parameters).toMatchObject({
+			properties: { asset: { type: "string" } },
+		});
+		expect(second.event.options.timeoutMs).toBe(123);
+		expect(result.runtimeContext.messages[0]).toMatchObject({
+			role: "user",
+			content: [
+				{ type: "text", text: "inspect assets" },
+				{ type: "image", data: "image-bytes", mimeType: "image/png" },
+			],
+		});
+	});
+
+	it("fails closed on an unsupported context role", async () => {
+		await expect(
+			runRequest({
+				context: { messages: [{ role: "system", content: "unsupported" }] } as unknown as Context,
+				extensions: [
+					`export default function(pi) {
+						pi.on("before_model_request", () => undefined);
+					}`,
+				],
+			}),
+		).rejects.toThrow();
+		expect((globalThis as Record<string, unknown>)[RUNTIME_STORE]).toBe(0);
+	});
+
+	it("fails closed on unsupported assistant content", async () => {
+		await expect(
+			runRequest({
+				context: {
+					messages: [{ role: "assistant", content: [{ type: "audio", data: "unsafe" }] }],
+				} as unknown as Context,
+				extensions: [
+					`export default function(pi) {
+						pi.on("before_model_request", () => undefined);
+					}`,
+				],
+			}),
+		).rejects.toThrow("unsupported model request assistant content");
+		expect((globalThis as Record<string, unknown>)[RUNTIME_STORE]).toBe(0);
+	});
+
+	async function runRequest({
+		extensions,
+		settings = { httpIdleTimeoutMs: 123 },
+		requestOptions = {},
+		context = semanticContext(),
+	}: {
+		extensions: string[];
+		settings?: Partial<Settings>;
+		requestOptions?: SimpleStreamOptions;
+		context?: Context;
+	}): Promise<{
+		order: string[];
+		events: unknown[];
+		runtimeContext: Context;
+		runtimeOptions: SimpleStreamOptions;
+	}> {
+		const model = createModel("openai-completions");
+		const extensionsDir = join(agentDir, "extensions");
+		mkdirSync(extensionsDir, { recursive: true });
+		for (const [index, source] of extensions.entries()) {
+			writeFileSync(join(extensionsDir, `capture-${index}.ts`), source);
+		}
+
+		const authStorage = AuthStorage.create(join(agentDir, "auth.json"));
+		await authStorage.modify(model.provider, async () => ({ type: "api_key", key: "test-api-key" }));
+		const registry = await createModelRegistry(authStorage, join(agentDir, "models.json"));
+		const order: string[] = [];
+		let runtimeContext: Context | undefined;
+		let runtimeOptions: SimpleStreamOptions | undefined;
+		registry.registerProvider(model.provider, {
+			api: model.api,
+			streamSimple: (_model, receivedContext, receivedOptions) => {
+				(globalThis as Record<string, string[]>)[ORDER_STORE].push("runtime");
+				(globalThis as Record<string, number>)[RUNTIME_STORE] += 1;
+				runtimeContext = receivedContext;
+				runtimeOptions = receivedOptions;
+				return doneStream(model.api);
+			},
+		});
+
+		const { session } = await createAgentSession({
+			cwd,
+			agentDir,
+			model,
+			modelRuntime: getModelRuntime(registry),
+			settingsManager: SettingsManager.inMemory(settings),
+			sessionManager: SessionManager.inMemory(cwd),
+		});
+		try {
+			const stream = await session.agent.streamFunction(model, context, requestOptions);
+			await stream.result();
+			const events = (globalThis as Record<string, unknown>)[EVENT_STORE] as Array<{ kind: string }>;
+			return {
+				order: (globalThis as Record<string, string[]>)[ORDER_STORE],
+				events,
+				runtimeContext: runtimeContext!,
+				runtimeOptions: runtimeOptions!,
+			};
+		} finally {
+			session.dispose();
+			registry.unregisterProvider(model.provider);
+		}
+	}
+});
+
+function createModel(api: Api): Model<Api> {
+	return {
+		id: "capture-model",
+		name: "Capture Model",
+		api,
+		provider: "capture-provider",
+		baseUrl: "https://capture.invalid/v1",
+		reasoning: false,
+		input: ["text"],
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		contextWindow: 128000,
+		maxTokens: 4096,
+	};
+}
+
+function semanticContext(): Context {
+	return {
