# Default LLM. Set DEEPSEEK_API_KEY in the startup environment.
CAPSTONE_PUBLIC_PROVIDER=deepseek
CAPSTONE_PUBLIC_MODEL=deepseek-flash

# OpenAI: comment the two lines above, enable the two lines below,
# and set OPENAI_API_KEY in the startup environment.
# When using startup overrides, set both Provider and model together.
# CAPSTONE_PUBLIC_PROVIDER=openai
# CAPSTONE_PUBLIC_MODEL=@OPENAI_DEFAULT_MODEL@

# Only the App is published. Change this port if it is already in use.
CAPSTONE_APP_PORT=19173
