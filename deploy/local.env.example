# Copy to deploy/local.env, replace every value, then run:
# docker compose --env-file deploy/local.env up --build
# Task budgets, in seconds. Research may override the shared application value.
CAPSTONE_THREAD_ATTEMPT_TIMEOUT_SECONDS=1800
CAPSTONE_ENTERPRISE_RESEARCH_TIMEOUT_SECONDS=7200
# Optional partial overrides, shared by API, worker and native executor.
# CAPSTONE_CAPACITY_JSON={"artifact_file_bytes":134217728}
# Debug stops the task at the first capacity exceedance. No retry or fallback.
CAPSTONE_CAPACITY_MODE=normal
# Container ceilings are applied before application startup.
CAPSTONE_NATIVE_MEMORY_LIMIT=2g
CAPSTONE_NATIVE_PIDS_LIMIT=512
CAPSTONE_NATIVE_TMP_SIZE=512m
POSTGRES_PASSWORD=replace-with-url-safe-database-password
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
CAPSTONE_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
CAPSTONE_PUBLIC_DEMO=true
CAPSTONE_THREAD_OPEN_ACCESS=true
CAPSTONE_HOSTED_APPLICATION=capstone
CAPSTONE_RUNTIME_PROFILE=capstone-workbench-v1
# Opt in only for a recorded autonomous research validation candidate.
CAPSTONE_AUTONOMOUS_RESEARCH=0
CAPSTONE_PUBLIC_PROVIDER=deepseek
CAPSTONE_PUBLIC_MODEL=deepseek-flash
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
CAPSTONE_SESSION_IDLE_SECONDS=600
CAPSTONE_WORKER_MAX_SESSIONS=8
CAPSTONE_ARTIFACT_BUCKET=capstone-private
# General Pi control authentication. Generate a separate local token.
CAPSTONE_GENERAL_CONTROL_TOKEN=replace-with-local-general-pi-control-token
# Optional production-data MCP resource. Point to an operator-owned directory
# containing a mode-0600 connection.json. The native host reads it; task UIDs do not.
# CAPSTONE_DATA_GATEWAY_CONFIG_DIR=/absolute/path/to/data-gateway/runtime/network-gateway
# CAPSTONE_DATA_GATEWAY_CONNECTION_FILE=/run/capstone-private/data-gateway/connection.json

# Workbench new-session default: local or intranet; profile definitions are backend-owned.
CAPSTONE_WORKBENCH_PRESET=local
