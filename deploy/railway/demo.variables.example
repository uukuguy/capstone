# Checklist only. Do not paste real credentials into this file or commit a
# populated copy. Set values in the capstone-demo Railway environment.

DATABASE_URL=<set-in-railway>
CAPSTONE_OPERATOR_TOKEN=<set-in-railway>
CAPSTONE_HOSTED_APPLICATION=capstone
CAPSTONE_RUNTIME_PROFILE=capstone-workbench-v1
CAPSTONE_DEPLOYMENT_STAGE=user-trial
CAPSTONE_FAMILY_HEALTH_URLS=pandapower=http://capstone-worker.railway.internal:8766,pypsa=http://capstone-worker-pypsa.railway.internal:8766
# Worker overrides: capstone-worker selects pandapower; capstone-worker-pypsa
# selects pypsa and uses its own private wake origin on port 8766.
# Workers are execution families. Each can host multiple Domain Packs.
PORT=8766
CAPSTONE_THREAD_OPEN_ACCESS=true
CAPSTONE_PUBLIC_DEMO=true
CAPSTONE_PUBLIC_PROVIDER=deepseek
CAPSTONE_PUBLIC_MODEL=deepseek-flash
# Session/context/stream limits come from the selected runtime profile.
CAPSTONE_WORKER_MAX_SESSIONS=12
CAPSTONE_WORKER_WAKE_URL=http://capstone-worker.railway.internal:8766
CAPSTONE_ALLOWED_HOSTS=<demo-api-host-without-scheme>
CAPSTONE_ALLOWED_ORIGINS=https://<demo-app-host>
CAPSTONE_ARTIFACT_BACKEND=s3
CAPSTONE_ARTIFACT_BUCKET=<demo-bucket-credential>
CAPSTONE_S3_ENDPOINT=<demo-bucket-endpoint-credential>
AWS_ACCESS_KEY_ID=<set-in-railway>
AWS_SECRET_ACCESS_KEY=<set-in-railway>
AWS_DEFAULT_REGION=<demo-bucket-region>
DEEPSEEK_API_KEY=<set-in-railway>

# App service build variable; it contains an origin only, never a secret.
VITE_API_ORIGIN=https://<demo-api-host>
