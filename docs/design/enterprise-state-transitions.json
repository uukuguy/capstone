{
  "schema": "capstone-design-transitions/1",
  "default": "reject_invalid_state",
  "transitions": [
    {"from": "waiting_input", "trigger": "input_applied", "to": "queued"},
    {"from": "paused", "trigger": "input_applied", "to": "paused"},
    {"from": "running", "trigger": "input_applied", "to": "running"},
    {"from": "queued", "trigger": "input_applied", "to": "queued"},
    {"from": "waiting_input", "trigger": "revise_goal", "to": "queued"},
    {"from": "paused", "trigger": "revise_goal", "to": "paused"},
    {"from": "queued", "trigger": "revise_goal", "to": "queued"},
    {
      "from": "queued",
      "trigger": "start",
      "to": "running"
    },
    {
      "from": "queued",
      "trigger": "missing_input",
      "to": "waiting_input"
    },
    {
      "from": "queued",
      "trigger": "invalid_configuration",
      "to": "failed"
    },
    {
      "from": "running",
      "trigger": "message",
      "to": "running"
    },
    {
      "from": "running",
      "trigger": "revise_goal",
      "to": "running"
    },
    {
      "from": "running",
      "trigger": "need_input",
      "to": "waiting_input"
    },
    {
      "from": "running",
      "trigger": "pause_requested",
      "to": "running"
    },
    {
      "from": "running",
      "trigger": "pause_settled",
      "to": "paused"
    },
    {
      "from": "running",
      "trigger": "delivery_complete",
      "to": "completed"
    },
    {
      "from": "running",
      "trigger": "delivery_partial",
      "to": "partial"
    },
    {
      "from": "running",
      "trigger": "fatal_error",
      "to": "failed"
    },
    {
      "from": "running",
      "trigger": "budget_exhausted",
      "to": "paused"
    },
    {
      "from": "queued",
      "trigger": "cancel_settled",
      "to": "cancelled"
    },
    {
      "from": "running",
      "trigger": "cancel_settled",
      "to": "cancelled"
    },
    {
      "from": "waiting_input",
      "trigger": "cancel_settled",
      "to": "cancelled"
    },
    {
      "from": "paused",
      "trigger": "cancel_settled",
      "to": "cancelled"
    },
    {
      "from": "waiting_input",
      "trigger": "resume",
      "to": "queued"
    },
    {
      "from": "paused",
      "trigger": "resume",
      "to": "queued"
    },
    {
      "from": "partial",
      "trigger": "resume",
      "to": "queued"
    },
    {
      "from": "completed",
      "trigger": "resume",
      "to": "queued"
    },
    {
      "from": "failed",
      "trigger": "resume",
      "to": "queued"
    },
    {
      "from": "cancelled",
      "trigger": "resume",
      "to": "queued"
    },
    {
      "from": "completed",
      "trigger": "revise_goal",
      "to": "queued"
    },
    {
      "from": "partial",
      "trigger": "revise_goal",
      "to": "queued"
    },
    {
      "from": "failed",
      "trigger": "revise_goal",
      "to": "queued"
    },
    {
      "from": "cancelled",
      "trigger": "revise_goal",
      "to": "queued"
    }
  ],
  "guards": {
    "input_applied": ["authorized", "open_request_matches_goal", "response_persisted", "safe_boundary_or_no_active_attempt"],
    "start": [
      "valid_lease",
      "authorized",
      "minimum_execution_context_ready",
      "budget_available"
    ],
    "message": [
      "valid_lease",
      "command_recorded",
      "safe_boundary"
    ],
    "revise_goal": [
      "authorized",
      "revision_cas",
      "invalidate_dependents"
    ],
    "pause_settled": [
      "no_new_dispatch",
      "checkpoint_confirmed"
    ],
    "cancel_settled": [
      "no_new_dispatch",
      "unresolved_actions_preserved"
    ],
    "resume": [
      "authorized",
      "revision_cas",
      "new_attempt",
      "isolate_unknown_actions_and_conflicting_dependencies"
    ],
    "delivery_complete": [
      "current_goal",
      "all_required_satisfied",
      "required_deliverables_persisted",
      "no_stale_delivery_dependencies"
    ],
    "delivery_partial": [
      "usable_message_or_artifacts",
      "unmet_requirements_recorded"
    ],
    "missing_input": [
      "external_input_needed",
      "no_viable_authorized_next_action"
    ],
    "need_input": [
      "external_input_needed",
      "no_viable_authorized_next_action"
    ],
    "invalid_configuration": [
      "execution_foundation_unavailable",
      "no_recoverable_configuration_path"
    ],
    "fatal_error": [
      "execution_foundation_unrecoverable"
    ],
    "budget_exhausted": [
      "dispatch_blocked",
      "checkpoint_confirmed"
    ]
  }
}
