{
  "id": "operations.rolling_dispatch",
  "tool_name": "pypsa_ops_rolling_dispatch",
  "availability": "published",
  "context_effect": {
    "requires_state": [],
    "consumes_state": [],
    "produces_state": [
      "pypsa-operations.result"
    ],
    "invalidates_state": [],
    "result_kind": "pypsa-operations.result",
    "projector": "pypsa-operations-result-v1"
  },
  "purpose": "Solve registered storage dispatch in sequential two-snapshot horizons.",
  "applies_to": [
    "registered PyPSA rolling-storage model"
  ],
  "not_for": [
    "unregistered models",
    "arbitrary solver options",
    "raw Network access"
  ],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "reference",
      "handoff_ref"
    ],
    "properties": {
      "reference": {
        "type": "string",
        "pattern": "^pypsa-model:sha256:[a-f0-9]{64}$"
      },
      "handoff_ref": {
        "type": "string",
        "pattern": "^handoff:sha256:[a-f0-9]{64}$"
      }
    }
  },
  "requires": [
    "application-granted model handoff"
  ],
  "produces": [
    "result_ref",
    "evidence_refs",
    "per-snapshot generator dispatch",
    "store energy",
    "realized operating cost"
  ],
  "common_next": [],
  "recovery": {
    "solve_failed": [
      "Report that the registered operation did not reach an optimum."
    ]
  }
}
