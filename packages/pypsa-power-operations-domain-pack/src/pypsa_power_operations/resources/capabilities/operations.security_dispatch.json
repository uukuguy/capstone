{
  "id": "operations.security_dispatch",
  "tool_name": "pypsa_ops_security_dispatch",
  "availability": "published",
  "context_effect": {
    "requires_state": [], "consumes_state": [],
    "produces_state": ["pypsa-operations.result"], "invalidates_state": [],
    "result_kind": "pypsa-operations.result", "projector": "pypsa-operations-result-v1"
  },
  "purpose": "Solve security-constrained dispatch for a registered outage set and authorized current-run model.",
  "applies_to": ["registered triangle network and outage set triangle-l3"],
  "not_for": ["unregistered outages", "arbitrary topology changes"],
  "input_schema": {
    "type": "object", "additionalProperties": false,
    "required": ["reference", "handoff_ref", "outage_set_id"],
    "properties": {
      "reference": {"type": "string", "pattern": "^pypsa-model:sha256:[a-f0-9]{64}$"},
      "handoff_ref": {"type": "string", "pattern": "^handoff:sha256:[a-f0-9]{64}$"},
      "outage_set_id": {"type": "string", "enum": ["triangle-l3"]}
    }
  },
  "requires": ["application-granted model handoff"],
  "produces": ["result_ref", "evidence_refs", "bounded security dispatch data"],
  "common_next": [],
  "recovery": {"solve_failed": ["Report that the registered outage case did not reach an optimum."]}
}
